# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/shopbc"

# ─── NextAuth ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Get from https://dashboard.stripe.com/webhooks (use Stripe CLI for local dev)
STRIPE_WEBHOOK_SECRET="whsec_..."

# ─── Microsoft Business Central ───────────────────────────────────────────────
# Azure App Registration credentials
BC_TENANT_ID="your-azure-tenant-id"
BC_CLIENT_ID="your-azure-app-client-id"
BC_CLIENT_SECRET="your-azure-app-client-secret"

# BC environment name (e.g. "Production" or "Sandbox")
BC_ENVIRONMENT="Production"

# Company ID (GUID) from Business Central
# Find it at: Settings → Company Information → scroll to "Company ID"
BC_COMPANY_ID="your-bc-company-guid"
