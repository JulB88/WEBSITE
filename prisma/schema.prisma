generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN       // Full system access, can manage admins
  ADMIN             // Full admin panel
  MANAGER           // Products, orders, categories (no settings/user management)
  CUSTOMER_SERVICE  // Orders + customer read-only
  BUSINESS          // Business customer with custom pricing
  CUSTOMER          // Regular customer
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CARD        // Payé par carte (Stripe) au moment de l'achat
  ON_ACCOUNT  // Porté au compte client — facturé puis payé plus tard
}

enum PaymentStatus {
  UNPAID   // Aucun paiement reçu
  PARTIAL  // Paiement partiel reçu
  PAID     // Payé en totalité
}

enum ProductSource {
  BC      // Imported from Business Central
  MANUAL  // Created manually via the admin dashboard
}

enum ProductStatus {
  DRAFT     // Missing required fields — hidden from store, cannot be activated
  ACTIVE    // All required fields present, visible in store
  INACTIVE  // All required fields present, hidden from store by choice
}

enum AccountType {
  ASSET      // Actif
  LIABILITY  // Passif
  EQUITY     // Capitaux propres
  REVENUE    // Produits
  EXPENSE    // Charges
}

enum FiscalPeriodStatus {
  OPEN    // Écritures permises
  CLOSED  // Fermé (réouvrable)
  LOCKED  // Verrouillé définitivement
}

enum JournalSource {
  SALE          // Vente (commande facturée)
  PAYMENT       // Encaissement client
  BILL          // Facture fournisseur (phase 4)
  BILL_PAYMENT  // Paiement fournisseur (phase 4)
  EXPENSE       // Dépense (phase 4)
  MANUAL        // Écriture manuelle
  REVERSAL      // Contre-passation
}

enum JournalStatus {
  DRAFT   // Brouillon (modifiable)
  POSTED  // Postée (immuable)
  VOID    // Annulée (par contre-passation)
}

enum BillStatus {
  UNPAID   // Non payée
  PARTIAL  // Partiellement payée
  PAID     // Payée
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id               String            @id @default(cuid())
  email            String            @unique
  password         String?
  name             String?
  role             Role              @default(CUSTOMER)
  emailVerified    DateTime?
  image            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  accounts         Account[]
  sessions         Session[]
  businessCustomer BusinessCustomer?
  orders           Order[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Business Customers ──────────────────────────────────────────────────────

model BusinessCustomer {
  id                 String      @id @default(cuid())
  userId             String      @unique
  companyName        String
  vatNumber          String?
  /// Customer number in Business Central (optional at registration)
  customerNo         String?
  /// When no customerNo: "new_request" | "existing_unknown" | null
  accountRequestType String?
  discountPercent    Float       @default(0)
  /// Limite de crédit pour les achats au compte. 0 = achats au compte interdits.
  /// Le solde impayé (commandes ON_ACCOUNT non payées) ne peut pas dépasser cette limite.
  creditLimit        Float       @default(0)
  priceListId        String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  priceList          PriceList?  @relation(fields: [priceListId], references: [id])
  orders             Order[]
  statements         AccountStatement[]
}

// ─── Pricing ─────────────────────────────────────────────────────────────────

model PriceList {
  id                String             @id @default(cuid())
  name              String
  discountPercent   Float              @default(0)
  isDefault         Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  businessCustomers BusinessCustomer[]
  priceListItems    PriceListItem[]
  categoryDiscounts CategoryDiscount[]
}

model PriceListItem {
  id            String    @id @default(cuid())
  priceListId   String
  productId     String
  overridePrice Float?
  priceList     PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([priceListId, productId])
}

// ─── Categories ──────────────────────────────────────────────────────────────

model Category {
  id                String             @id @default(cuid())
  name              String
  nameEn            String?
  slug              String             @unique
  description       String?
  parentId          String?
  parent            Category?          @relation("CategoryTree", fields: [parentId], references: [id])
  children          Category[]         @relation("CategoryTree")
  products          Product[]
  categoryDiscounts CategoryDiscount[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([parentId])
  @@index([slug])
}

// Category-level discount — optionally scoped to a specific PriceList.
// null priceListId = applies to ALL customers in that category.
model CategoryDiscount {
  id              String     @id @default(cuid())
  categoryId      String
  priceListId     String?    // null = applies to all price lists / all customers
  discountPercent Float
  category        Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  priceList       PriceList? @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([categoryId])
  @@index([priceListId])
}

// ─── Products ────────────────────────────────────────────────────────────────

model Product {
  id             String          @id @default(cuid())
  bcItemNo       String          @unique
  name           String
  description    String?         @db.Text
  price          Float
  stock          Int             @default(0)
  imageUrl       String?
  category       String?         // Legacy BC category code (kept for BC sync)
  categoryId     String?         // FK to structured Category tree
  active         Boolean         @default(true)
  source         ProductSource   @default(BC)
  status         ProductStatus   @default(DRAFT)
  nameEn         String?
  descriptionEn  String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  productCategory Category?      @relation(fields: [categoryId], references: [id])
  priceListItems PriceListItem[]
  orderItems     OrderItem[]

  @@index([active])
  @@index([source])
  @@index([status])
  @@index([category])
  @@index([categoryId])
  @@index([active, categoryId])
  @@index([source, active])
}

// ─── Orders ──────────────────────────────────────────────────────────────────

model Order {
  id                    String            @id @default(cuid())
  userId                String
  businessCustomerId    String?
  status                OrderStatus       @default(PENDING)
  totalAmount           Float
  stripePaymentIntentId String?           @unique
  bcSalesOrderNo        String?
  // ─── Facturation au compte ───
  paymentMethod         PaymentMethod     @default(CARD)
  paymentStatus         PaymentStatus     @default(UNPAID)
  /// Somme des paiements enregistrés (table Payment)
  paidAmount            Float             @default(0)
  /// Numéro de facture (généré à la facturation au compte ou à l'achat carte)
  invoiceNo             String?
  /// Date de facturation au compte (null = pas encore facturée)
  invoicedAt            DateTime?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  user                  User              @relation(fields: [userId], references: [id])
  businessCustomer      BusinessCustomer? @relation(fields: [businessCustomerId], references: [id])
  orderItems            OrderItem[]
  payments              Payment[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentMethod, paymentStatus])
  @@index([businessCustomerId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Float
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

// ─── Paiements (confirmations manuelles sur commandes au compte) ─────────────

model Payment {
  id           String   @id @default(cuid())
  orderId      String
  /// Montant reçu (peut être partiel)
  amount       Float
  /// Mode de paiement : "cheque" | "virement" | "carte" | "comptant" | "autre"
  method       String   @default("autre")
  /// Note libre (n° de chèque, référence de virement…)
  note         String?
  /// Email du membre du personnel qui a enregistré le paiement
  recordedBy   String?
  createdAt    DateTime @default(now())
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
}

// ─── États de compte mensuels ────────────────────────────────────────────────

model AccountStatement {
  id                 String           @id @default(cuid())
  businessCustomerId String
  /// Période couverte : "2026-06" (année-mois)
  period             String
  /// Total facturé au compte durant la période
  totalBilled        Float
  /// Total des paiements reçus durant la période
  totalPaid          Float
  /// Solde impayé au moment de la génération
  balance            Float
  sentAt             DateTime?
  createdAt          DateTime         @default(now())
  businessCustomer   BusinessCustomer @relation(fields: [businessCustomerId], references: [id], onDelete: Cascade)

  @@unique([businessCustomerId, period])
  @@index([period])
}

// ─── Settings ────────────────────────────────────────────────────────────────

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

// ─── Modèles de courriels & workflows ────────────────────────────────────────

// Un modèle de courriel éditable (sujet + corps HTML avec variables {{...}}).
model EmailTemplate {
  id        String   @id @default(cuid())
  /// Clé système pour les modèles par défaut (null = créé par l'utilisateur)
  systemKey String?  @unique
  name      String
  subject   String
  bodyHtml  String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  triggers  EmailTrigger[]
}

// Un déclencheur : à quel événement système on envoie quel modèle.
model EmailTrigger {
  id         String         @id @default(cuid())
  /// Événement système : purchase_invoice | final_invoice | payment_confirmation | monthly_statement
  event      String         @unique
  templateId String?
  enabled    Boolean        @default(true)
  updatedAt  DateTime       @updatedAt
  template   EmailTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
}

// ─── Stripe Webhook Deduplication ────────────────────────────────────────────
// Prevents the same Stripe event from being processed more than once.
// Stripe guarantees at-least-once delivery — we enforce exactly-once here.

model StripeWebhookEvent {
  id          String   @id // Stripe event ID (e.g. evt_xxx) — already globally unique
  type        String   // e.g. "payment_intent.succeeded"
  processedAt DateTime @default(now())

  @@index([processedAt])
}

// ─── Comptabilité — Fondations configurables (Phase 1) ───────────────────────

// Plan comptable éditable (chart of accounts).
model LedgerAccount {
  id          String      @id @default(cuid())
  code        String      @unique      // ex. "1100"
  name        String                    // ex. "Comptes clients"
  type        AccountType
  parentId    String?
  parent      LedgerAccount?  @relation("AccountTree", fields: [parentId], references: [id])
  children    LedgerAccount[] @relation("AccountTree")
  description String?
  isActive    Boolean     @default(true)
  /// Compte par défaut (seedé, référencé par les mappages) — non supprimable
  isSystem    Boolean     @default(false)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  mappings        AccountMapping[]
  taxCollectedFor TaxCode[] @relation("TaxCollected")
  taxPaidFor      TaxCode[] @relation("TaxPaid")
  journalLines    JournalLine[]

  @@index([type])
  @@index([parentId])
}

// Mappage « rôle système → compte » (quel compte poster pour chaque type de transaction).
model AccountMapping {
  id        String         @id @default(cuid())
  /// SALES_REVENUE | ACCOUNTS_RECEIVABLE | CASH | ACCOUNTS_PAYABLE | DEFAULT_EXPENSE | COGS | ROUNDING | RETAINED_EARNINGS …
  key       String         @unique
  label     String
  accountId String?
  account   LedgerAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  updatedAt DateTime       @updatedAt
}

// Code de taxe configurable (TPS, TVQ, HST, TVA…).
model TaxCode {
  id                 String        @id @default(cuid())
  code               String        @unique  // ex. "TPS"
  name               String                   // ex. "Taxe sur les produits et services"
  rate               Float                    // 0.05
  jurisdiction       String?                  // "CA-QC"
  registrationNumber String?                  // n° d'inscription
  compound           Boolean       @default(false) // calculée sur (sous-total + taxes précédentes)
  isActive           Boolean       @default(true)
  isSystem           Boolean       @default(false)
  sortOrder          Int           @default(0)
  collectedAccountId String?                  // taxe perçue (passif)
  paidAccountId      String?                  // CTI/RTI récupérable (actif)
  collectedAccount   LedgerAccount? @relation("TaxCollected", fields: [collectedAccountId], references: [id], onDelete: SetNull)
  paidAccount        LedgerAccount? @relation("TaxPaid", fields: [paidAccountId], references: [id], onDelete: SetNull)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

// Devises et taux de change (multi-devise).
model Currency {
  code      String         @id          // "CAD", "USD"
  symbol    String                       // "$"
  name      String                       // "Dollar canadien"
  isBase    Boolean        @default(false)
  isActive  Boolean        @default(true)
  rates     ExchangeRate[]
}

model ExchangeRate {
  id           String   @id @default(cuid())
  currencyCode String
  currency     Currency @relation(fields: [currencyCode], references: [code], onDelete: Cascade)
  /// Unités de devise de base pour 1 unité de cette devise
  rate         Float
  asOf         DateTime
  createdAt    DateTime @default(now())

  @@index([currencyCode, asOf])
}

model FiscalYear {
  id        String         @id @default(cuid())
  name      String                       // "Exercice 2026"
  startDate DateTime
  endDate   DateTime
  createdAt DateTime       @default(now())
  periods   FiscalPeriod[]
}

model FiscalPeriod {
  id           String             @id @default(cuid())
  fiscalYearId String
  fiscalYear   FiscalYear         @relation(fields: [fiscalYearId], references: [id], onDelete: Cascade)
  name         String                       // "2026-06"
  startDate    DateTime
  endDate      DateTime
  status       FiscalPeriodStatus @default(OPEN)
  entries      JournalEntry[]

  @@unique([fiscalYearId, name])
  @@index([fiscalYearId])
}

// ─── Grand livre — écritures en partie double (Phase 2) ──────────────────────

model JournalEntry {
  id             String        @id @default(cuid())
  number         Int           @unique          // séquentiel, attribué au postage
  date           DateTime
  memo           String?
  source         JournalSource @default(MANUAL)
  /// Référence de la source pour l'idempotence : "sale:<orderId>", "payment:<id>"…
  sourceRef      String?
  status         JournalStatus @default(POSTED)
  currencyCode   String        @default("CAD")
  exchangeRate   Float         @default(1)
  createdBy      String?
  postedAt       DateTime?
  fiscalPeriodId String?
  /// Si cette écriture en contre-passe une autre
  reversalOfId   String?
  /// Synchronisation vers Business Central (optionnelle)
  bcSyncedAt     DateTime?
  bcError        String?
  createdAt      DateTime      @default(now())

  lines        JournalLine[]
  fiscalPeriod FiscalPeriod?  @relation(fields: [fiscalPeriodId], references: [id])
  reversalOf   JournalEntry?  @relation("Reversal", fields: [reversalOfId], references: [id])
  reversals    JournalEntry[] @relation("Reversal")

  @@unique([source, sourceRef])  // empêche le double-postage d'un même événement
  @@index([date])
  @@index([status])
}

model JournalLine {
  id                 String        @id @default(cuid())
  entryId            String
  entry              JournalEntry  @relation(fields: [entryId], references: [id], onDelete: Cascade)
  accountId          String
  account            LedgerAccount @relation(fields: [accountId], references: [id])
  /// Montants en devise de l'écriture
  debit              Decimal       @default(0) @db.Decimal(14, 2)
  credit             Decimal       @default(0) @db.Decimal(14, 2)
  /// Montants convertis en devise de base (pour les rapports)
  baseDebit          Decimal       @default(0) @db.Decimal(14, 2)
  baseCredit         Decimal       @default(0) @db.Decimal(14, 2)
  description        String?
  taxCodeId          String?
  businessCustomerId String?

  @@index([entryId])
  @@index([accountId])
}

// ─── Comptes fournisseurs (Phase 4) ──────────────────────────────────────────

model Vendor {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  contactName String?
  taxNumber   String?
  termsDays   Int      @default(30)  // délai de paiement
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  bills       Bill[]

  @@index([isActive])
}

model Bill {
  id         String        @id @default(cuid())
  vendorId   String
  number     String?                      // n° de facture du fournisseur
  date       DateTime
  dueDate    DateTime?
  memo       String?
  total      Float
  paidAmount Float         @default(0)
  status     BillStatus    @default(UNPAID)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  vendor     Vendor        @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  lines      BillLine[]
  payments   BillPayment[]

  @@index([vendorId])
  @@index([status])
  @@index([date])
}

model BillLine {
  id          String  @id @default(cuid())
  billId      String
  accountId   String                       // compte de charge / actif
  description String?
  amount      Float                         // montant hors taxe
  taxCodeId   String?                        // taxe récupérable (CTI/RTI)
  bill        Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
}

model BillPayment {
  id         String   @id @default(cuid())
  billId     String
  amount     Float
  method     String   @default("autre")
  note       String?
  recordedBy String?
  createdAt  DateTime @default(now())
  bill       Bill     @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId])
}

// Dépense au comptant (sans cycle de facture fournisseur)
model Expense {
  id            String   @id @default(cuid())
  date          DateTime
  vendorName    String?
  accountId     String                       // compte de charge
  description   String?
  amount        Float                         // hors taxe
  taxCodeId     String?
  paidFromCode  String   @default("CASH")     // mappage : compte d'où sort l'argent
  createdBy     String?
  createdAt     DateTime @default(now())

  @@index([date])
}
